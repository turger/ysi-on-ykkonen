REACT_APP_IS_PI=true
# Lauttasaaren silta Ruohikseen HSL:1310102
# Lauttasaaren silta Katajaharjuun HSL:1310101
# Lauttasaaren silta Vattuniemeen HSL:1310139
# ID:s separated with commas, if multiple stops should be merged to one box then separate these with plus +
REACT_APP_STOP_IDS=HSL:1310102,HSL:1310101+HSL:1310139
# Stop positioin : filtered public transport item
REACT_APP_FILTER=0:6,1:21

# Lauttasaaren silta bike stop id = 058
# Lauttasaaren ostoskeskus bike stop id = 057
# <stop-name>;<hsl-stop-id> pairs separated with commas
REACT_APP_BIKE_STOP_IDS=Silta:058,Metro:057

REACT_APP_LAT=60.1675
REACT_APP_LON=24.9311

# HSL API key https://digitransit.fi/en/developers/api-registration/
REACT_APP_HSL_KEY=
